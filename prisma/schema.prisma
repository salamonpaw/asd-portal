generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  PARTNER
  PARTNER_ADMIN
  SERVICE_TECHNICIAN
  STAFF
  WAREHOUSE_SPECIALIST
  ADMIN
}

enum PartnerLevel {
  STANDARD
  BRONZE
  SILVER
  GOLD
  STRATEGIC
}

enum ProjectStatus {
  NEW
  VERIFY
  ACTIVE
  NOPROT
  NEEDINFO
  DUP
  REJECT
  EXPIRED
  DEACT
  WON
  LOST
}

enum Procurement {
  BIEZACA
  ZAPYTANIE
  PRZETARG
}


enum ServiceOrderStatus {
  NOWE
  PRZYJĘTE
  CZĘŚCIOWO_ZREALIZOWANE
  ZREALIZOWANE
  ODRZUCONE
  ZAWIESZONE
  OCZEKUJE_NA_CZESCI   // brak części na stanie — czeka do expectedDate
}

enum Currency {
  PLN
  EUR
  USD
}

enum DiscountType {
  PERCENT
  AMOUNT
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  sessionVersion Int  @default(0)   // podbicie = wylogowanie wszystkich sesji użytkownika
  partnerId String?
  repId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner                    Partner?        @relation(fields: [partnerId], references: [id])
  rep                        Rep?            @relation(fields: [repId], references: [id])
  comments                   Comment[]
  serviceTechniciansOrders   ServiceOrder[]  @relation("ServiceTechnician")
  warehouseSpecialistOrders  ServiceOrder[]  @relation("WarehouseSpecialist")
}

// ─── Reps (Handlowcy ASD) ────────────────────────────────────────────────────

model Rep {
  id          String  @id @default(cuid())
  name        String
  initials    String
  email       String  @unique
  region      String
  phone       String?
  calendarUrl String?
  photoUrl    String?
  bio         String?

  users                        User[]
  partners                     Partner[]
  projects                     Project[]
  ordersAsRep                  Order[]  @relation("supervisorRep")
  ordersAsBok                  Order[]  @relation("supervisorBok")
  createdDiscounts             PartnerDiscount[]
  partnerAssignments           PartnerRepAssignment[]
  discountNotifications        PartnerDiscountNotification[]
  calendarClicks               CalendarClick[]
}

model CalendarClick {
  id        String   @id @default(cuid())
  repId     String
  rep       Rep      @relation(fields: [repId], references: [id], onDelete: Cascade)
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([repId])
  @@index([partnerId])
}

// ─── Partners ────────────────────────────────────────────────────────────────

model Partner {
  id               String       @id @default(cuid())
  name             String
  short            String
  city             String
  country          String
  level            PartnerLevel @default(BRONZE)
  discount         Int          @default(5)
  candidate        Boolean      @default(false)
  contact          String
  email            String
  phone            String
  since            String
  machinesReported Int          @default(0)
  repId            String
  currency         Currency     @default(PLN)
  minProfitMargin  Decimal      @default(10)
  createdAt        DateTime     @default(now())

  rep                      Rep                            @relation(fields: [repId], references: [id])
  users                    User[]
  projects                 Project[]
  markets                  Market[]
  serviceOrders            ServiceOrder[]
  productDiscounts         PartnerProductDiscount[]
  exchangeRates            CurrencyExchangeRate[]
  orderTemplates           OrderTemplate[]
  discounts                PartnerDiscount[]
  repAssignments           PartnerRepAssignment[]
  discountNotifications    PartnerDiscountNotification[]
  marketingMaterialAccess  MarketingMaterialAccess[]
  calendarClicks           CalendarClick[]
  salesReps                PartnerSalesRep[]
  projectRequests          ProjectRequest[]
  mailSettings             MailSettings?
  reminderSettings         ReminderSettings?
}

model Market {
  id        String  @id @default(cuid())
  name      String
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id              String        @id
  partnerId       String
  repId           String
  customerName    String
  customerTaxId   String
  customerCountry String
  location        String?
  branch          String?
  machines        String
  procurement     Procurement
  stage           String
  description     String
  decisionDate    String?
  interested      Boolean
  wantsSupport    Boolean
  support         String[]
  notes           String?
  discount        Int?
  lockedDiscountPercentage Int?
  salesRepId      String?
  reminderDaysBefore String?   // nadpisanie rytmu (np. "30,14,7"); null = domyślny partnera
  remindersMuted  Boolean       @default(false)
  status          ProjectStatus @default(VERIFY)
  protected       Boolean       @default(false)
  conflictsWith   String?
  createdAt       DateTime      @default(now())
  acceptedAt      DateTime?
  expiresAt       DateTime?
  updatedAt       DateTime      @updatedAt

  partner  Partner          @relation(fields: [partnerId], references: [id])
  rep      Rep              @relation(fields: [repId], references: [id])
  history  ProjectHistory[]
  comments Comment[]
  orders   Order[]
  salesRep PartnerSalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)

  @@index([customerTaxId])
}

model ProjectHistory {
  id        String   @id @default(cuid())
  projectId String
  date      DateTime @default(now())
  who       String
  text      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  text      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  code              String        @unique
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status            String        @default("pending")
  estimatedDays     Int?
  deliveryDate      DateTime?
  supervisorRepId   String?
  supervisorRep     Rep?          @relation("supervisorRep", fields: [supervisorRepId], references: [id])
  supervisorBokId   String?
  supervisorBok     Rep?          @relation("supervisorBok", fields: [supervisorBokId], references: [id])
  waitingFor        WaitingItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([projectId])
  @@index([code])
}

model WaitingItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           String
  status         String   @default("pending")
  note           String?
  trackingNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
}

// ─── Machine Types ────────────────────────────────────────────────────────────

model MachineType {
  id        String    @id @default(cuid())
  name      String    @unique
  label     String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Service Orders ───────────────────────────────────────────────────────────

model ServiceOrder {
  id                     String                @id @default(cuid())
  code                   String                @unique
  partnerId              String
  partner                Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  technicianId           String
  technician             User                  @relation("ServiceTechnician", fields: [technicianId], references: [id])
  items                  ServiceOrderItem[]
  status                 ServiceOrderStatus    @default(NOWE)
  deliveryAddress        String
  neededDate             DateTime?
  notes                  String?
  warehouseSpecialistId  String?
  warehouseSpecialist    User?                 @relation("WarehouseSpecialist", fields: [warehouseSpecialistId], references: [id])
  rejectionReason        String?
  trackingNumber         String?
  // Wycena — wspólna dla całego zamówienia: ceny pozycji są w tej walucie
  currency               Currency              @default(PLN)
  exchangeRate           Decimal               @default(1)   // ile PLN za 1 jednostkę waluty (PLN = 1)
  pricedAt               DateTime?
  expectedDate           DateTime?             // przewidywana dostępność części (status OCZEKUJE_NA_CZESCI)
  parentOrderId          String?               // zamówienie, z którego wydzielono brakujące części
  parentOrder            ServiceOrder?         @relation("OrderSplit", fields: [parentOrderId], references: [id], onDelete: SetNull)
  childOrders            ServiceOrder[]        @relation("OrderSplit")
  history                ServiceOrderHistory[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([partnerId])
  @@index([code])
}

model ServiceOrderItem {
  id                 String       @id @default(cuid())
  serviceOrderId     String
  serviceOrder       ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product      @relation(fields: [productId], references: [id])
  quantity           Int
  // Wszystkie kwoty: za 1 szt., w walucie zamówienia, zapamiętane w chwili wyceny
  unitPrice          Decimal?     // cena katalogowa (Product.sellingPrice przeliczona) albo ręczna
  manualPrice        Boolean      @default(false) // cena wpisana ręcznie przez magazyn (na odpowiedzialność, w historii)
  costPrice          Decimal?     // cena zakupu (Product.costPrice przeliczona) — do marży
  discountType       DiscountType?
  discountValue      Decimal?     // PERCENT: %; AMOUNT: kwota na 1 szt.
  finalPrice         Decimal?     // cena po rabacie za 1 szt.
  notes              String?
  createdAt          DateTime     @default(now())

  @@index([serviceOrderId])
  @@index([productId])
}

model Product {
  id               String      @id @default(cuid())
  sku              String      @unique
  name             String
  description      String?
  machineTypeId    String
  machineType      MachineType @relation(fields: [machineTypeId], references: [id], onDelete: Cascade)
  parentProductId  String?
  parentProduct    Product?    @relation("ProductHierarchy", fields: [parentProductId], references: [id])
  childProducts    Product[]   @relation("ProductHierarchy")
  location         String?
  serialNumber     String?
  supplier         String?
  machineCount     Int?
  costPrice        Decimal?      // Cena zakupu
  sellingPrice     Decimal?      // Cena sprzedaży dla klienta
  serviceOrderItems ServiceOrderItem[]
  partnerDiscounts PartnerProductDiscount[]
  inventory        Inventory?
  templateItems    OrderTemplateItem[]
  productImages    ProductImage[]  @relation("ProductImages")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([sku])
  @@index([machineTypeId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  filePath  String   // /public/images/filename.jpg
  fileName  String
  mimeType  String   // image/jpeg, image/png
  fileSize  Int      // bytes
  uploadedBy String
  uploadedAt DateTime @default(now())
  deletedAt DateTime?

  @@index([productId])
}

model PartnerProductDiscount {
  id             String   @id @default(cuid())
  partnerId      String
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Decimal  @default(0)  // Procentowy rabat dla tego partnera na ten produkt
  verifiedAt     DateTime? // Ostatnia weryfikacja rabatu
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([partnerId, productId])
  @@index([partnerId])
  @@index([productId])

}

model ServiceOrderHistory {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedBy      String
  action         String
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([serviceOrderId])
}

// ─── Exchange Rates ────────────────────────────────────────────────────────────

model CurrencyExchangeRate {
  id              String   @id @default(cuid())
  partnerId       String?
  partner         Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  fromCurrency    Currency
  toCurrency      Currency
  rate            Decimal
  effectiveDate   DateTime
  createdAt       DateTime @default(now())

  @@index([partnerId])
  @@index([effectiveDate])
}

// ─── System Config ────────────────────────────────────────────────────────────

model SystemConfig {
  id                String   @id @default(cuid())
  minProfitMargin   Decimal  @default(10)
  reminderDaysBefore Int     @default(5)
  updatedAt         DateTime @updatedAt
}

// ─── Content Management ───────────────────────────────────────────────────────

model ContentItem {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  group     String
  updatedAt DateTime @updatedAt
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Inventory {
  id           String   @id @default(cuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  audits InventoryAudit[]

  @@index([productId])

}

model InventoryAudit {
  id           String    @id @default(cuid())
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  fromStock    Int
  toStock      Int
  changedBy    String
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([inventoryId])
}

// ─── Staff Discount & Rebate System ───────────────────────────────────────

model PartnerDiscount {
  id                   String   @id @default(cuid())
  partnerId            String
  partner              Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  percentage           Decimal
  expirationDate       DateTime
  fallbackPercentage   Decimal  @default(0)
  machineCountRequired Int?
  status               String   @default("ACTIVE")
  createdByRepId       String
  createdBy            Rep      @relation(fields: [createdByRepId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  notifications        PartnerDiscountNotification[]

  @@unique([partnerId, expirationDate])
  @@index([partnerId])
  @@index([createdByRepId])
}

model PartnerRepAssignment {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  repId     String
  rep       Rep      @relation(fields: [repId], references: [id])
  role      String   // "PRIMARY", "SECONDARY"
  createdAt DateTime @default(now())

  @@unique([partnerId, repId])
  @@index([partnerId])
  @@index([repId])
}

model PartnerDiscountNotification {
  id                    String   @id @default(cuid())
  partnerId             String
  partner               Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  repId                 String
  rep                   Rep      @relation(fields: [repId], references: [id])
  partnerDiscountId     String
  partnerDiscount       PartnerDiscount @relation(fields: [partnerDiscountId], references: [id], onDelete: Cascade)
  daysUntilExpiry       Int
  notificationSent60Days Boolean @default(false)
  notificationSent30Days Boolean @default(false)
  status                String   @default("PENDING")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([partnerId])
  @@index([repId])
  @@index([partnerDiscountId])
}

// ─── Marketing Materials Library ──────────────────────────────────────────

model MarketingMaterial {
  id         String   @id @default(cuid())
  filename   String   // nazwa wyświetlana / oryginalna nazwa pliku
  url        String   // /uploads/marketing/... (plik) lub link zewnętrzny (http...)
  mimeType   String?
  fileSize   Int?
  type       String   // VIDEO, CATALOG, DATASHEET, BROCHURE, etc
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  createdBy  String   // email of admin/superadmin
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  partnerAccess MarketingMaterialAccess[]

  @@index([type])
}

model MarketingMaterialAccess {
  id                String   @id @default(cuid())
  materialId        String
  material          MarketingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  partnerId         String
  partner           Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  accessGrantedAt   DateTime @default(now())

  @@unique([materialId, partnerId])
  @@index([materialId])
  @@index([partnerId])
}

// ─── Order Templates ──────────────────────────────────────────────────────────

model OrderTemplate {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String   // "Serwis A - Części standardowe", etc
  items     OrderTemplateItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

model OrderTemplateItem {
  id         String        @id @default(cuid())
  templateId String
  template   OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([templateId])
  @@index([productId])
}

// ─── Handlowcy partnera, zgłoszenia, poczta, przypomnienia ───────────────────

model PartnerSalesRep {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  active    Boolean  @default(true)
  formToken String   @unique @default(cuid())   // osobisty link do formularza zapotrzebowania
  createdAt DateTime @default(now())

  projects  Project[]
  requests  ProjectRequest[]

  @@index([partnerId])
}

model ProjectRequest {
  id              String          @id @default(cuid())
  partnerId       String
  partner         Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  salesRepId      String
  salesRep        PartnerSalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  customerName    String
  customerTaxId   String
  customerCountry String          @default("Polska")
  location        String?
  branch          String?
  machines        String
  procurement     Procurement
  stage           String
  description     String
  decisionDate    String?
  interested      Boolean
  wantsSupport    Boolean
  support         String[]        @default([])
  notes           String?
  status          String          @default("PENDING")   // PENDING | APPROVED | REJECTED
  partnerNote     String?
  projectId       String?
  createdAt       DateTime        @default(now())
  decidedAt       DateTime?

  @@index([partnerId, status])
  @@index([salesRepId])
}

model MailSettings {
  id          String   @id @default(cuid())
  partnerId   String?  @unique   // null = globalny serwer ASD
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  host        String
  port        Int      @default(587)
  secure      Boolean  @default(false)
  username    String?
  passwordEnc String?  // AES-256-GCM, klucz z MAIL_SECRET_KEY / NEXTAUTH_SECRET
  fromName    String?
  fromEmail   String
  replyTo     String?
  updatedAt   DateTime @updatedAt
}

model ReminderSettings {
  id                    String   @id @default(cuid())
  partnerId             String   @unique
  partner               Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  expiryEnabled         Boolean  @default(true)   // wygaśnięcie ochrony projektu
  decisionEnabled       Boolean  @default(true)   // planowana data decyzji klienta
  needInfoEnabled       Boolean  @default(true)   // ASD prosi o uzupełnienie
  pendingRequestEnabled Boolean  @default(true)   // zgłoszenie handlowca czeka na partnera
  daysBefore            String   @default("30,14,7,1")
  repeatEveryDays       Int      @default(3)
  updatedAt             DateTime @updatedAt
}

model ReminderLog {
  id        String   @id @default(cuid())
  type      String   // EXPIRY | DECISION | NEEDINFO | PENDING_REQUEST
  key       String
  projectId String?
  requestId String?
  recipient String
  sentAt    DateTime @default(now())

  @@index([key])
  @@index([type, projectId])
  @@index([type, requestId])
}
